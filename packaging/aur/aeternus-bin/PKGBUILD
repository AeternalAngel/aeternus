# Maintainer: Gabriel (AeternalAngel) <83485448+AeternalAngel@users.noreply.github.com>
pkgname=aeternus-bin
pkgver=1.6.0
pkgrel=1
pkgdesc='GPU-accelerated terminal emulator written in Rust (prebuilt binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/AeternalAngel/aeternus'
license=('MIT')
depends=('glibc' 'hicolor-icon-theme' 'libgcc' 'libxkbcommon' 'vulkan-icd-loader')
optdepends=(
  'fontconfig: resolve the system monospace font'
  'xdg-utils: open links with Ctrl+click'
  'libnotify: desktop notifications from programs'
  'libx11: X11 support'
  'wayland: Wayland support'
)
provides=('aeternus')
conflicts=('aeternus')
options=('!debug')
_short=${pkgver%.0}
source_x86_64=("$url/releases/download/v$pkgver/aeternus-$_short-linux-x86_64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/aeternus-$_short-linux-aarch64.tar.gz")
sha256sums_x86_64=('12d0c43d8338754545989377b7d65c264aff26ecac8122f4ca1678d03749acbd')
sha256sums_aarch64=('7a3877716fd3c980fcba59755b5ccbd8d4014d8f18ffcdf5d1b14012a6ba1a84')

package() {
  cd "aeternus-$_short-linux-$CARCH"
  DESTDIR="$pkgdir" ./install.sh --prefix /usr
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
